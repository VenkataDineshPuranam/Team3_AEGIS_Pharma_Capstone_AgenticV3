# Copy to .env and fill in. Never commit real values.

# LLM_PROVIDER selects packages/config/llm_client.py's backend.
#   anthropic       -- Route A (ADR-009), Claude via the Anthropic API directly.
#                      REQUIRED for Phase 5/6 real synthesize/critic_verify runs and any
#                      result that counts toward Stage 20a's interim-assumption exit criteria.
#   groq            -- dev-only substitute for exercising the real LLM call path (prompt
#                      formatting, token accounting, retries) while ANTHROPIC_API_KEY is being
#                      sorted. NOT a design decision -- ADR-009's Route A is unchanged. Any
#                      output produced under this provider is provisional and must be re-run
#                      under `anthropic` before it counts as a real interim-assumption result.
#   azure_foundry   -- deployment target (ADR-009). Implemented Stage 23 -- see
#                      AzureFoundryLLM in packages/config/llm_client.py.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Small/cheap model on Groq -- dev-only provider (see LLM_PROVIDER note above), token-conserving default.
GROQ_MODEL=llama-3.1-8b-instant

# Azure AI Foundry -- LLM_PROVIDER=azure_foundry. Foundry portal -> your project ->
# Deployments -> the deployed model -> "Target URI" and key. AzureFoundryLLM talks to it
# through the OpenAI-compatible chat-completions route every Foundry Models-as-a-Service
# deployment exposes, regardless of the underlying model family.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=
# Usually fine at the default; override only if the portal's Target URI shows a different
# api-version.
AZURE_FOUNDRY_API_VERSION=2024-05-01-preview
# LANGSMITH_TRACING=true is the actual on/off switch -- LANGSMITH_API_KEY alone does
# nothing. LangGraph auto-traces every node/tool call once this is set, no code changes.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aegis-pharma-v2
# Stage 20b's response cache (packages/config/redis_client.py, services/integration/
# response_cache.py). This session used a cloud Redis (Redis Cloud/Upstash-style, free
# tier) -- format: redis://default:<password>@<host>:<port>. Azure Cache for Redis is
# the ADR-009 deployment target; local `redis://localhost:6379` also works if you have
# Redis running locally.
REDIS_URL=redis://localhost:6379

# Neo4j -- backs the Stage 13 semantic layer / evidence-retrieval knowledge graph
# (docs/architecture/ontology/kg_schema.md: 17 classes, 14 edge types).
# Using Neo4j AuraDB free tier: sign up at console.neo4j.io, create an instance, copy the
# generated bolt+s:// URI and password (username is always "neo4j" for a new Aura instance).
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Stage 23 -- Live HITL escalation notifications (services/integration/
# hitl_escalation_watch.py, services/integration/notifier.py). A background poller inside
# the API process (services/api/main.py's lifespan) checks pending runs every
# HITL_NOTIFIER_POLL_SECONDS and, the FIRST time a run crosses severity 3 (T2) or 4 (T3),
# writes an audit record (always -- powers the web app's notification bell with no
# SMTP configuration required) and sends ONE best-effort email (only if the SMTP_* /
# NOTIFY_EMAIL_TO block below is filled in). This is a visibility notice only -- it never
# approves, rejects, or widens who may decide a run; see that module's docstring.
#
# Gmail SMTP requires an App Password, not your regular account password (Google rejects
# plain-password SMTP once 2-Step Verification is on). Generate one at
# https://myaccount.google.com/apppasswords with 2-Step Verification already enabled, then
# paste the 16-character value below (spaces optional). SMTP_HOST/PORT are Gmail's
# standard submission endpoint; any other SMTP relay works too by pointing these
# elsewhere -- see notifier.py's module docstring for why this is plain SMTP rather than
# an MCP tool call.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER if left blank -- set separately only if sending "as" a different
# address than the one authenticating.
SMTP_FROM=
NOTIFY_EMAIL_TO=puranam.dinesh@gmail.com
# How often the background poller checks the pending queue. 60s is frequent enough that a
# run crossing a threshold is noticed promptly without hammering the audit store; each
# scan is a handful of cheap sqlite reads, not a network call.
HITL_NOTIFIER_POLL_SECONDS=60
